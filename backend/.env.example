# MongoDB
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>

# Auth
JWT_SECRET=change_me

# Servidor
PORT=4000

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# ElevenLabs (Text-to-Speech)
# Obtener la API key en https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
# ID de una voz en español de tu cuenta de ElevenLabs (Voice Library > filtrar por Spanish)
# El valor por defecto (EXAVITQu4vr4xnSDxMaL) es una voz multilingüe de ElevenLabs.
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2
